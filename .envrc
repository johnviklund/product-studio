# Use the personal GitHub account for gh in this repo (per-shell, no global switch).
# Secret lives in ~/.config/gh-tokens/johnviklund (chmod 600, never committed).
# If the file is absent, GH_TOKEN is empty and gh falls back to the keyring default.
export GH_TOKEN="$(cat "$HOME/.config/gh-tokens/johnviklund" 2>/dev/null)"
